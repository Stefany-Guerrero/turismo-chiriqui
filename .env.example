# Base de datos MariaDB (puerto 3306)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=turismo_chiriqui

# Base de datos MongoDB (puerto 27017) — sincronizacion secundaria
MONGO_URI=mongodb://localhost:27017

# Clave secreta para sesiones (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Correo electronico (opcional, necesario para notificaciones)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# URL base del sitio
BASE_URL=http://localhost:5000

# Contraseña inicial del admin (solo se usa la primera vez)
ADMIN_INITIAL_PASSWORD=admin2026
